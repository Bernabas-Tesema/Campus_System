SECRET_KEY=campus-eat-dev-secret-key-change-in-production
DEBUG=True
DB_NAME=campus_eat
DB_USER=campus_eat
DB_PASSWORD=campus_eat_secret
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin account (created automatically by `python manage.py seed_data` on container start)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@campus.eat
ADMIN_PASSWORD=admin123

# Demo data seeding (lounges/users/foods). Default is admin-only.
# To seed demo data manually: `python manage.py seed_data --demo`
SEED_DEMO_DATA=false

# SMTP settings (optional) - set these to enable real email delivery
# Example: SMTP_HOST=smtp.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
EMAIL_TIMEOUT=5
DEFAULT_FROM_EMAIL=bernabastesemagedore@gmail.com
